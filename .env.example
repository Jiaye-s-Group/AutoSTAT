# AutoSTAT uses an OpenAI-compatible chat completion API.
# You can also configure these values from the Streamlit sidebar.
# Optional sidebar persistence writes to ~/.config/autostat/config.toml.

OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=deepseek-chat

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=120

# Prompt and artifact size guards.
AUTOSTAT_MODELING_PROMPT_HEAD_CHARS=12000
AUTOSTAT_MODELING_PROMPT_DATA_CHARS=12000
AUTOSTAT_MODELING_PROMPT_USER_TEXT_CHARS=6000
AUTOSTAT_MODELING_PROMPT_CONTEXT_CHARS=12000
AUTOSTAT_MODELING_PROMPT_MAX_COLUMNS=300

AUTOSTAT_VIZ_PROMPT_DATA_CHARS=20000
AUTOSTAT_VIZ_PROMPT_HEAD_CHARS=12000
AUTOSTAT_VIZ_PROMPT_CONTEXT_CHARS=12000
AUTOSTAT_VIZ_PROMPT_USER_TEXT_CHARS=6000
AUTOSTAT_USE_FIGURE_IMAGES=1
AUTOSTAT_FIG_IMAGE_WIDTH=1100
AUTOSTAT_FIG_IMAGE_HEIGHT=720
AUTOSTAT_FIG_IMAGE_TIMEOUT_SECONDS=20
AUTOSTAT_DISABLE_FIGURE_IMAGES_AFTER_TIMEOUT=1

AUTOSTAT_DEBUG=false
